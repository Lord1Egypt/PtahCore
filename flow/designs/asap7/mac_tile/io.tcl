# PtahCore -- mac_tile edge pin constraints (TILE_SPEC abutment contract).
#
# Every west-in is mirrored to its east-out (same y) and every north-in
# to its south-out (same x), so tiles abut pin-on-pin: cell j's a_out[k]
# lands exactly on cell j+1's a_in[k], and a stacked row's b_out/drain_s
# land on the next row's b_in/drain_n. Mirroring IS the contract --
# alignment by construction, not by placer luck.

set_io_pin_constraint -region left:* -pin_names { clk_in rst_in en_in zero_in slot_in[0] slot_in[1] drain_slot_in[0] drain_slot_in[1] row_hit_in a_in[0] a_in[1] a_in[2] a_in[3] a_in[4] a_in[5] a_in[6] a_in[7] a_in[8] a_in[9] a_in[10] a_in[11] a_in[12] a_in[13] a_in[14] a_in[15] a_in[16] a_in[17] a_in[18] a_in[19] a_in[20] a_in[21] a_in[22] a_in[23] a_in[24] a_in[25] a_in[26] a_in[27] a_in[28] a_in[29] a_in[30] a_in[31] }
set_io_pin_constraint -region top:*  -pin_names { b_in[0] b_in[1] b_in[2] b_in[3] b_in[4] b_in[5] b_in[6] b_in[7] b_in[8] b_in[9] b_in[10] b_in[11] b_in[12] b_in[13] b_in[14] b_in[15] b_in[16] b_in[17] b_in[18] b_in[19] b_in[20] b_in[21] b_in[22] b_in[23] b_in[24] b_in[25] b_in[26] b_in[27] b_in[28] b_in[29] b_in[30] b_in[31] drain_n_in[0] drain_n_in[1] drain_n_in[2] drain_n_in[3] drain_n_in[4] drain_n_in[5] drain_n_in[6] drain_n_in[7] drain_n_in[8] drain_n_in[9] drain_n_in[10] drain_n_in[11] drain_n_in[12] drain_n_in[13] drain_n_in[14] drain_n_in[15] drain_n_in[16] drain_n_in[17] drain_n_in[18] drain_n_in[19] drain_n_in[20] drain_n_in[21] drain_n_in[22] drain_n_in[23] drain_n_in[24] drain_n_in[25] drain_n_in[26] drain_n_in[27] drain_n_in[28] drain_n_in[29] drain_n_in[30] drain_n_in[31] }

