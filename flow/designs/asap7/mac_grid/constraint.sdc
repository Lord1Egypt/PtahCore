# South strip interface.
set_input_delay  -clock clk_s 600 [get_ports {drain_col_sel}]
set_output_delay -clock clk_s 600 [get_ports {drain_data}]

# Settled-bus drain: 2-cycle, RTL-enforced by STORE's row-change
# settle bubble (store.sv; ARRAY_SPEC SS3). Everything that crosses
# the tile sea into the drain register goes through row 31's
# drain_s_out pins; the per-cycle drain_col_sel path does not.
set chain_pins {}
for {set j 0} {$j < 32} {incr j} {
    lappend chain_pins "row\[31\].col\[$j\].u_tile/drain_s_out[*]"
}
set_multicycle_path 2 -setup -through [get_pins $chain_pins]
set_multicycle_path 1 -hold  -through [get_pins $chain_pins]

# Real constants / slow global signals.
set_false_path -from [get_ports "rst_v\[*\]"]
set_false_path -from [get_ports "drain_n_flat\[*\]"]

# Propagate from the start: pre-CTS repair must see the eastward
# macro clk arcs (ideal-clock analysis drops the j*de capture
# credit and reports tens of thousands of phantom setup
# violations the resizer then burns an hour failing to fix).
set_propagated_clock [all_clocks]
